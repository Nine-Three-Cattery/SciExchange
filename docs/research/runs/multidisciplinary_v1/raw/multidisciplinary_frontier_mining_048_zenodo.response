Figure5.xlsx/content"}}, {"id": "1eacb06c-709a-4291-9ac4-735d6b718eab", "key": "Figure4.xlsx", "size": 72915, "checksum": "md5:79e83ff9fe756aa087ab8748c39f8683", "links": {"self": "https://zenodo.org/api/records/5533869/files/Figure4.xlsx/content"}}], "swh": null, "owners": [{"id": "256311"}], "status": "published", "stats": {"downloads": 508, "unique_downloads": 462, "views": 584, "unique_views": 530, "version_downloads": 508, "version_unique_downloads": 462, "version_unique_views": 530, "version_views": 584}, "state": "done", "submitted": true}, {"created": "2026-09-25T09:51:25.962354+00:00", "modified": "2026-09-25T09:51:26.197573+00:00", "id": 21026781, "conceptrecid": "21026780", "doi": "10.5281/zenodo.21026781", "conceptdoi": "10.5281/zenodo.21026780", "doi_url": "https://doi.org/10.5281/zenodo.21026781", "metadata": {"title": "Data set to \"Feasibility study on the applicability of pure hydrogen as a fuel for fire testing of hazardous containers\"", "doi": "10.5281/zenodo.21026781", "publication_date": "2026-06-29", "description": "<p>Accompanying dataset for the publication \"Feasibility study on the applicability of pure hydrogen as a fuel for fire testing of hazardous containers\". The dataset ist structered in the following way:</p>\n<p><br>H2_Data/</p>\n<p>\u251c\u2500\u2500 Readme.txt</p>\n<p>\u251c\u2500\u2500 FRP_exp #Fire Reference Plate experiments data, Recorded transient data&nbsp;</p>\n<p>\u2514\u2500\u2500 First_exp_set /</p>\n<p>&nbsp; &nbsp; &nbsp; &nbsp;\u251c\u2500\u2500 Measurement_data # Transient measurement data&nbsp;</p>\n<p>&nbsp; &nbsp; &nbsp; &nbsp;\u2514\u2500\u2500 IR_Camera_data # Data of the IR-Cam records</p>\n<p>FRP_exp contains the data of experiments in which a Fire reference plate was heated by a hydrogen jet flame, containing the trainsient data of the thermocouples recording the heating process and mass flow data of the hydroge as .txt files structured like a .csv.</p>\n<p>The First_exp_set contains data of experiments with different hydrogen jet flames in different configurations. It contains also transient data as a .txt as well as IR-cam recordings. The IR-cam recordings consist of the Infratec format of the camera, as well as the exported data of the averaged Flame image of the experiment as a png and as a table in txt form for further analysis. The IR Data and transient data are numbered in the order of the experiments, failed experiments are exluded. The Experment Numbers in DoE Order used in the publication are as follows:</p>\n<p>15, 04, 03, 05, 06, 07, 17, 09, 01, 10, 16</p>\n<p>With 01, 10 and 16 being repeats of the Experment 9.</p>", "access_right": "open", "creators": [{"name": "Naster, Maximilian", "affiliation": "Federal Institute For Materials Research and Testing"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "bam"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "21026780"}}]}}, "title": "Data set to \"Feasibility study on the applicability of pure hydrogen as a fuel for fire testing of hazardous containers\"", "links": {"self": "https://zenodo.org/api/records/21026781", "self_html": "https://zenodo.org/records/21026781", "preview_html": "https://zenodo.org/records/21026781?preview=1", "doi": "https://doi.org/10.5281/zenodo.21026781", "self_doi": "https://doi.org/10.5281/zenodo.21026781", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21026781", "reserve_doi": "https://zenodo.org/api/records/21026781/draft/pids/doi", "parent": "https://zenodo.org/api/records/21026780", "parent_html": "https://zenodo.org/records/21026780", "parent_doi": "https://doi.org/10.5281/zenodo.21026780", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21026780", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21026781/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:21026781/sequence/default", "files": "https://zenodo.org/api/records/21026781/files", "media_files": "https://zenodo.org/api/records/21026781/media-files", "latest": "https://zenodo.org/api/records/21026781/versions/latest", "latest_html": "https://zenodo.org/records/21026781/latest", "versions": "https://zenodo.org/api/records/21026781/versions", "draft": "https://zenodo.org/api/records/21026781/draft", "access_links": "https://zenodo.org/api/records/21026781/access/links", "access_grants": "https://zenodo.org/api/records/21026781/access/grants", "access_users": "https://zenodo.org/api/records/21026781/access/users", "access_request": "https://zenodo.org/api/records/21026781/access/request", "access": "https://zenodo.org/api/records/21026781/access", "communities": "https://zenodo.org/api/records/21026781/communities", "communities-suggestions": "https://zenodo.org/api/records/21026781/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/21026781/request-deletion", "file_modification": "https://zenodo.org/api/records/21026781/file-modification", "quota_increase": "https://zenodo.org/api/records/21026781/quota-increase", "requests": "https://zenodo.org/api/records/21026781/requests"}, "updated": "2026-09-25T09:51:26.197573+00:00", "recid": "21026781", "revision": 4, "files": [{"id": "d0502548-70ec-4372-b64c-e0f4762f2746", "key": "H2_Data.zip", "size": 75221648, "checksum": "md5:019059edc40e776d6c54d917931e4e39", "links": {"self": "https://zenodo.org/api/records/21026781/files/H2_Data.zip/content"}}], "swh": null, "owners": [{"id": "1707357"}], "status": "published", "stats": {"downloads": 9, "unique_downloads": 9, "views": 44, "unique_views": 37, "version_downloads": 9, "version_unique_downloads": 9, "version_unique_views": 37, "version_views": 44}, "state": "done", "submitted": true}], "total": 3}, "aggregations": {"publication_date": {"buckets": [{"key": "2021", "doc_count": 1, "label": "2021", "is_selected": false}, {"key": "2022", "doc_count": 1, "label": "2022", "is_selected": false}, {"key"