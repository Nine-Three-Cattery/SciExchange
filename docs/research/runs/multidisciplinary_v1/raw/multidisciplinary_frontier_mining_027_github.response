ang/dQdV-dVdQ-tool.git","svn_url":"https://github.com/kongxiuyichuang/dQdV-dVdQ-tool","homepage":null,"size":482,"stargazers_count":0,"watchers_count":0,"language":"HTML","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":1,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":1,"open_issues":0,"watchers":0,"default_branch":"main","score":1.0},{"id":408313809,"node_id":"MDEwOlJlcG9zaXRvcnk0MDgzMTM4MDk=","name":"Differential-Scanning-Calorimetry-","full_name":"nishkarsearch/Differential-Scanning-Calorimetry-","private":false,"owner":{"login":"nishkarsearch","id":89826514,"node_id":"MDQ6VXNlcjg5ODI2NTE0","avatar_url":"https://avatars.githubusercontent.com/u/89826514?v=4","gravatar_id":"","url":"https://api.github.com/users/nishkarsearch","html_url":"https://github.com/nishkarsearch","followers_url":"https://api.github.com/users/nishkarsearch/followers","following_url":"https://api.github.com/users/nishkarsearch/following{/other_user}","gists_url":"https://api.github.com/users/nishkarsearch/gists{/gist_id}","starred_url":"https://api.github.com/users/nishkarsearch/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/nishkarsearch/subscriptions","organizations_url":"https://api.github.com/users/nishkarsearch/orgs","repos_url":"https://api.github.com/users/nishkarsearch/repos","events_url":"https://api.github.com/users/nishkarsearch/events{/privacy}","received_events_url":"https://api.github.com/users/nishkarsearch/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/nishkarsearch/Differential-Scanning-Calorimetry-","description":"Differential Scanning Calorimetry (DSC) Investigation / DSC Testing Nishka Research – Your most reliable thermal testing partner. “Differential Scanning Calorimetry (DSC) / Differential Thermal Analysis (DTA)/ Thermogravimetric Analysis or Thermal Gravimetric Analysis (TGA).” Differential Scanning Calorimetry studies or DSC testing is a thermo analytical technique, which compute heat capacity (Endothermic/Exothermic) as a function of temperature or time”. In DSC analysis a known mass (small quantities in milligrams) of sample is heated or cooled at a pre program controlled temperature, which changes in heat capacities are scanned and output is recorded as graph. Output of DSC is known as Thermogram. DSC thermogram reveals most valuable information of a material which includes Malting point (Tm), Glass transition temperature (Tg), Purity, Crystallinity, Specific heat capacity, Thermal stability, Curing temperature, Oxidative nature & Phase changes.  DSC testing has a wide range of applications covering wide materials such as Chemical, Pharmaceutical, Plastic, Polymer, Food, Rubber, Composites, Laminates, Organic compounds, Explosives, biological samples, Coatings and petroleum samples. Since wide range of materials could be tested using DSC technique, It found applications in diversified industries which includes Cosmetics, Batteries, Metallurgy, Textiles, tool manufacturing, Coal, Semi conductor and Automotive industry. DSC testing is most common thermal analytical technique used in R&Ds, Quality control, Quality assurance and many analytical procedures.","fork":false,"url":"https://api.github.com/repos/nishkarsearch/Differential-Scanning-Calorimetry-","forks_url":"https://api.github.com/repos/nishkarsearch/Differential-Scanning-Calorimetry-/forks","keys_url":"https://api.github.com/repos/nishkarsearch/Differential-Scanning-Calorimetry-/keys{/key_id}","collaborators_url":"https://api.github.com/repos/nishkarsearch/Differen