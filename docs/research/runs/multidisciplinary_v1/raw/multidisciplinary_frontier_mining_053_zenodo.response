{"created": "2024-07-09T13:51:59.704291+00:00", "modified": "2024-11-07T12:59:20.779688+00:00", "id": 12699251, "conceptrecid": "12699250", "doi": "10.5281/zenodo.12699251", "conceptdoi": "10.5281/zenodo.12699250", "doi_url": "https://doi.org/10.5281/zenodo.12699251", "metadata": {"title": "Dataset of  \"Key Aspects in Designing High-Throughput Workflows in Electrocatalysis Research: A Case Study on IrCo Mixed-Metal Oxidese\"", "doi": "10.5281/zenodo.12699251", "publication_date": "2024-07-09", "description": "<p>With the growing interest of the electrochemical community in high-throughput (HT) experimentation as a powerful tool in accelerating materials discovery, the implementation of HT methodologies and the design of HT workflows has gained traction. We identify 6 aspects essential to HT workflow design in electrochemistry and beyond to ease the incorporation of HT methods in the community&rsquo;s research and to assist in their improvement. We study IrCo mixed-metal oxides (MMOs) for the oxygen evolution reaction (OER) in acidic media using the mentioned aspects to provide a practical example of possible workflow design pitfalls and strategies to counteract them.&nbsp;</p>", "access_right": "open", "creators": [{"name": "Hrbek, Tom\u00e1\u0161", "affiliation": "Charles University", "orcid": "0000-0002-6041-2125"}, {"name": "Bouzek, Karel", "affiliation": "University of Chemistry and Technology", "orcid": "0000-0002-0394-0634"}, {"name": "Pau\u0161ov\u00e1, \u0160\u00e1rka", "affiliation": "University of Chemistry and Technology", "orcid": "0000-0003-2494-1510"}], "contributors": [{"name": "Hrbek, Tom\u00e1\u0161", "affiliation": "Charles University, Faculty of Mathematics and Physics, Department of Surface and Plasma Science", "type": "Researcher", "orcid": "0000-0002-6041-2125"}, {"name": "Przybysz, Joanna", "affiliation": "Helmholtz-Institute Erlangen-N\u00fcrnberg for Renewable Energy", "type": "Researcher", "orcid": "0009-0000-8402-5691"}], "keywords": ["VZ2", "UK", "214 021", "214 023", "high throughput", "Ir-Co", "electrochemistry"], "related_identifiers": [{"identifier": "10.1021/acsmaterialslett.4c01372", "relation": "isPublishedIn", "resource_type": "publication-article", "scheme": "doi"}], "dates": [{"type": "submitted", "description": "Sent to peer review process"}], "version": "version 1", "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "CZ.02.01.01/00/22_008/0004617", "internal_id": "037n8p820::CZ.02.01.01/00/22_008/0004617", "funder": {"name": "Ministry of Education Youth and Sports"}, "title": "The Energy Conversion and Storage"}], "communities": [{"id": "ecostor"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "12699250"}}]}}, "title": "Dataset of  \"Key Aspects in Designing High-Throughput Workflows in Electrocatalysis Research: A Case Study on IrCo Mixed-Metal Oxidese\"", "links": {"self": "https://zenodo.org/api/records/12699251", "self_html": "https://zenodo.org/records/12699251", "preview_html": "https://zenodo.org/records/12699251?preview=1", "doi": "https://doi.org/10.5281/zenodo.12699251", "self_doi": "https://doi.org/10.5281/zenodo.12699251", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.12699251", "reserve_doi": "https://zenodo.org/api/records/12699251/draft/pids/doi", "parent": "https://zenodo.org/api/records/12699250", "parent_html": "https://zenodo.org/records/12699250", "parent_doi": "https://doi.org/10.5281/zenodo.12699250", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.12699250", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:12699251/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:12699251/sequence/default", "files": "https://zenodo.org/api/records/12699251/files", "media_files": "https://zenodo.org/api/records/12699251/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:12699251:VZ2