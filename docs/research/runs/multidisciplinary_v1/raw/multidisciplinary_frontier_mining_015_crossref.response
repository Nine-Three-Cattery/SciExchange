dri","year":"2005","journal-title":"ACM SIGOPS Operating Systems Review"},{"key":"ref15","doi-asserted-by":"publisher","DOI":"10.1109\/GLOCOM.2009.5425280"},{"key":"ref16","doi-asserted-by":"publisher","DOI":"10.1145\/1030083.1030103"},{"key":"ref17","first-page":"223","article-title":"Design and Implementation of a TCG-based Integrity Measurement Architecture","volume":"13","author":"sailer","year":"2004","journal-title":"USENIX Security Symposium"},{"key":"ref18","article-title":"SMART: Secure and Minimal Architecture for (Establishing Dynamic) Root of Trust","author":"el defrawy","year":"2012","journal-title":"NDSS"},{"key":"ref19","year":"2017","journal-title":"Intel&#x00AE; Trusted Execution Technology - Software Development Guide"},{"key":"ref4","doi-asserted-by":"publisher","DOI":"10.1145\/3061639.3062276"},{"key":"ref3","doi-asserted-by":"publisher","DOI":"10.1145\/2976749.2978358"},{"key":"ref6","first-page":"552","article-title":"The Geometry of Innocent Flesh on the Bone: Return-into-libc without Function Calls (on the x86)","author":"shacham","year":"2007","journal-title":"Computer Communications of the ACM"},{"key":"ref5","doi-asserted-by":"publisher","DOI":"10.1145\/3240765.3240821"},{"key":"ref8","doi-asserted-by":"publisher","DOI":"10.1109\/SP.2016.62"},{"key":"ref7","first-page":"161","article-title":"Control-Flow Bending: On the Effectiveness of Control-Flow Integrity","author":"carlini","year":"2015","journal-title":"USENIX Security Symposium"},{"key":"ref2","doi-asserted-by":"publisher","DOI":"10.1109\/DSN.2009.5270348"},{"key":"ref9","year":"0","journal-title":"SSH CRC-32 Compensation Attack Detector Vulnerability"},{"key":"ref1","doi-asserted-by":"publisher","DOI":"10.1145\/1655108.1655117"},{"key":"ref20","first-page":"108","year":"2009","journal-title":"ARM Security Technology Building A Secure System Using TrustZone Technology"},{"key":"ref22","first-page":"147","article-title":"Code-pointer integrity","author":"kuznetsov","year":"2014","journal-title":"Proc USENIX Symp on Operating System Design and Implementation"},{"key":"ref21","doi-asserted-by":"publisher","DOI":"10.1145\/1102120.1102165"},{"key":"ref24","doi-asserted-by":"publisher","DOI":"10.1145\/2744769.2744847"},{"key":"ref23","doi-asserted-by":"publisher","DOI":"10.1145\/2857705.2857722"},{"key":"ref25","doi-asserted-by":"publisher","DOI":"10.1109\/SP.2016.9"}],"event":{"name":"2019 17th International Conference on Privacy, Security and Trust (PST)","location":"Fredericton, NB, Canada","start":{"date-parts":[[2019,8,26]]},"end":{"date-parts":[[2019,8,28]]}},"container-title":["2019 17th International Conference on Privacy, Security and Trust (PST)"],"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx7\/8937293\/8949011\/08949036.pdf?arnumber=8949036","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,7,29]],"date-time":"2025-07-29T18:23:07Z","timestamp":1753813387000},"score":28.59443,"resource":{"primary":{"URL":"https:\/\/ieeexplore.ieee.org\/document\/8949036\/"}},"issued":{"date-parts":[[2019,8]]},"references-count":25,"URL":"https:\/\/doi.org\/10.1109\/pst47121.2019.8949036","published":{"date-parts":[[2019,8]]}},{"indexed":{"date-parts":[[2026,7,10]],"date-time":"2026-07-10T20:06:36Z","timestamp":1783713996993,"version":"3.55.0"},"reference-count":63,"publisher":"Springer Science and Business Media LLC","issue":"3","license":[{"start":{"date-parts":[[2025,9,1]],"date-time":"2025-09-01T00:00:00Z","timestamp":1756684800000},"content-version":"tdm","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"},{"start":{"date-parts":[[2025,9,22]],"date-time":"2025-09-22T00:00:00Z","timestamp":1758499200000},"content-version":"vor","delay-in-days":21,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"funder":[{"DOI":"10.13039\/501100002347","name":"Bundesministerium f\u00fcr Bildung und Forschung","doi-asserted-by":"publisher","award":["16ME0800K"],"award-info":[{"award-number":["16ME0800K"]}],"id":[{"id":"10.13039\/501100002347","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100002347","name":"Bundesministerium f\u00fcr Bildung und Forschung","doi-asserted-by":"publisher","award":["16ME0800K"],"award-info":[{"award-number":["16ME0800K"]}],"id":[{"id":"10.13039\/501100002347","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100002347","name":"Bundesministerium f\u00fcr Bildung und Forschung","doi-asserted-by":"publisher","award":["16KIS1578"],"award-info":[{"award-number":["16KIS1578"]}],"id":[{"id":"10.13039\/501100002347","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100019457","name":"Chips Joint Undertaking","doi-asserted-by":"publisher","award":["101007273"],"award-info":[{"award-number":["101007273"]}],"id":[{"id":"10.13039\/100019457","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/100019457","name":"Chips Joint Undertaking","doi-asserted-by":"publisher","award":["101007273"],"award-info":[{"award-number":["101007273"]}],"id":[{"id":"10.13039\/100019457","id-type":"DOI","asserted-by":"publisher"}]},{"DOI":"10.13039\/501100004168","name":"Universit\u00e4t zu L\u00fcbeck","doi-asserted-by":"crossref","id":[{"id":"10.13039\/501100004168","id-type":"DOI","asserted-by":"crossref"}]}],"content-domain":{"domain":["link.springer.com"],"crossmark-restriction":false},"short-container-title":["J Cryptogr Eng"],"published-print":{"date-parts":[[2025,9]]},"abstract":"<jats:title>Abstract<\/jats:title>\n          <jats:p>Their ubiquity and typically cost-driven design make platforms based on microcontroller units (MCUs) a preferred target for cyber attacks. While Hardware Roots of Trust (RoTs) aim to establish security services, such as confidentiality, integrity, and authentication, the abundance of mutually exclusive cryptographic algorithms taxes heavily on the MCUs\u2019 limited resources. In the presented work, we leverage fundamental cryptographic implications to derive the necessary services from a single sponge-based algorithm\u2019s engine coupled with a Physically Unclonable Function (PUF) for randomness. The proposed single engine can provide all required security services to build an HRoT. In particular, the sponge-based <jats:sc>Ascon<\/jats:sc> is chosen to realize Authenticated Encryption with Associated Data (AEAD) and hashing and, at the same time to establish all preconditions for required services like digital signatures or Message Authentication Codes (MACs). To demonstrate the practicality of our hardware RoT, we integrate it into a RISC-V-based System on Chip (SoC) as a memory-mapped peripheral. As proof of the concept, we implement the SoC on the AMD\/Xilinx Artix-7 FPGA and synthesize it for the 130nm Open Source SkyWater PDK. The results show that our hardware RoT design adds 10.35% Look-Up Tables (LUTs) for the FPGA implementation and 0.76% area for the ASIC implementation. Our <jats:sc>Ascon<\/jats:sc> engine FPGA implementation incurs 2.33<jats:inline-formula>\n              <jats:alternatives>\n                <jats:tex-math>$$\\times $$<\/jats:tex-math>\n                <mml:math xmlns:mml=\"http:\/\/www.w3.org\/1998\/Math\/MathML\">\n                  <mml:mo>\u00d7<\/mml:mo>\n                <\/mml:math>\n              <\/jats:alternatives>\n            <\/jats:inline-formula> less logic- and 4.48<jats:inline-formula>\n              <jats:alternatives>\n                <jats:tex-math>$$\\times $$<\/jats:tex-math>\n                <mml:math xmlns:mml=\"http:\/\/www.w3.org\/1998\/Math\/MathML\">\n                  <mml:mo>\u00d7<\/mml:mo>\n                <\/mml:math>\n              <\/jats:alternatives>\n            <\/jats:inline-formula> less memory resources compared to the state-of-the-art. This hardware RoT integration hence enables cost-effective and efficient deployments for resource-constrained devices.<\/jats:p>","DOI":"10.1007\/s13389-025-00381-9","type":"journal-article","created":{"date-parts":[[2025,9,22]],"date-time":"2025-09-22T13:19:08Z","timestamp":1758547148000},"update-policy":"https:\/\/doi.org\/10.1007\/springer_crossmark_policy","source":"Crossref","is-referenced-by-count":2,"title":["Single engine architecture for hardware root of trust"],"prefix":"10.1007","volume":"15","author":[{"ORCID":"https:\/\/orcid.org\/0009-0004-0164-2862","authenticated-orcid":false,"given":"Daniel","family":"Najork","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0000-5031-2430","authenticated-orcid":false,"given":"Andrija","family":"Ne\u0161kovi\u0107","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-7323-3898","authenticated-orcid":false,"given":"Hsin-Kun","family":"Lin","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0002-4820-4726","authenticated-orcid":false,"given":"Christian","family":"Ewert","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-6702-9401","authenticated-orcid":false,"given":"Sven","family":"Dreier","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0003-1911-756X","authenticated-orcid":false,"given":"Mladen","family":"Berekovic","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0004-9413-2078","authenticated-orcid":false,"given":"Rainer","family":"Buchty","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-7380-5270","authenticated-orcid":false,"given":"Saleh","family":"Mulhem","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"297","published-online":{"date-parts":[[2025,9,22]]},"reference":[{"key":"381_CR1","doi-asserted-by":"crossref","unstructured":"Rowland, M., Karch, B.: A review of technologies that can provide a \u2019root of trust\u2019 for operational technologies. Tech. Rep., Sandia National Lab. (SNL-NM), Albuquerque, NM (United States) (2022). https:\/\/www.osti.gov\/biblio\/1861944","DOI":"10.2172\/1861944"},{"key":"381_CR2","unstructured":"GlobalPlatform. Root of Trust Definitions and Requirements-Version 1.0.1 (2017). https:\/\/globalplatform.org\/wp-content\/uploads\/2018\/06\/GP_RoT_Definitions_and_Requirements_v1.0.1_PublicRelease_CC.pdf. Accessed: 2025-01-18"},{"key":"381_CR3","doi-asserted-by":"publisher","first-page":"69603","DOI":"10.1109\/ACCESS.2024.3400685","volume":"12","author":"E Rama","year":"2024","unstructured":"Rama, E., et al.: Trustworthy integrated circuits: from safety to security and beyond. IEEE Access 12, 69603\u201369632 (2024)","journal-title":"IEEE Access"},{"key":"381_CR4","doi-asserted-by":"crossref","unstructured":"Ayache, M., Rama, E., Mulhem, S., Berekovic, M., Korb, M.: Holistic framework for evaluating the trustworthiness of integrated circuits, 1\u20134 (2024)","DOI":"10.1109\/VLSI-SoC62099.2024.10767800"},{"key":"381_CR5","unstructured":"Pamnani, V.: Tpm fundamentals (2024). https:\/\/learn.microsoft.com\/en-us\/windows\/security\/hardware-security\/tpm\/tpm-fundamentals"},{"key":"381_CR6","doi-asserted-by":"crossref","unstructured":"Jacob, H.N., Werling, C., Buhren, R., Seifert, J.-P.: faultpm: Exposing amd ftpms\u2019 deepest secrets, 1128\u20131142 (2023)","DOI":"10.1109\/EuroSP57164.2023.00069"},{"key":"381_CR7","unstructured":"Cloud, G.: Bolstering security across google cloud. https:\/\/blog.google\/products\/google-cloud\/bolstering-security-across-google-cloud\/ (2017). Accessed: 2024-12-09"},{"key":"381_CR8","unstructured":"Johnson, S., Rizzo, D., Ranganathan, P., McCune, J., Ho, R.: Titan: enabling a 